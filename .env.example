# Copy to .env and adjust. Never commit .env.
PORT=3000

# Matches docker-compose.yml (local development only)
POSTGRES_USER=renest
POSTGRES_PASSWORD=renest
POSTGRES_DB=renest
DATABASE_URL="postgresql://renest:renest@localhost:5432/renest?schema=public"

# Password given to every seeded account (`npm run db:seed`). Local/dev only, at least 8 chars.
SEED_USER_PASSWORD=change-me-locally

# Dedicated database for `npm run test:e2e` (created and migrated automatically). Must differ from
# DATABASE_URL so e2e runs never touch dev data.
E2E_DATABASE_URL="postgresql://renest:renest@localhost:5432/renest_e2e?schema=public"

# development | test | production (default development). Production refuses the JWT_SECRET below.
NODE_ENV=development

# JWT signing secret: at least 32 characters. This placeholder is for local development only and is
# rejected when NODE_ENV=production; any shared environment needs its own random value
# (e.g. `openssl rand -hex 32`).
JWT_SECRET=local-dev-only-jwt-secret-change-me-0123456789
# Access token lifetime (one token, no refresh): a number with a unit, e.g. 7d, 12h, 30m.
JWT_EXPIRES_IN=7d

# Global rate limit per client IP, every route. A coarse safety net; login/sign-up have their own
# fixed, layered limits (src/auth/credentials-throttle.ts).
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=1000

# Login/sign-up limits per 60 s: per client IP, and across all clients (per IP + email is fixed at
# 5). Keep these defaults outside the local Docker stack; docker-compose.yml raises both for the
# frontend's e2e suite, which sends every request from one client IP.
CREDENTIALS_IP_LIMIT=20
CREDENTIALS_GLOBAL_LIMIT=100

# Proxies allowed to set the client IP via X-Forwarded-For (Express `trust proxy`): the Next.js
# server forwards the browser's IP. `loopback` = Next.js on the same host. Otherwise use the Next
# server's IP/CIDR (e.g. 10.0.3.7 or 10.0.0.0/16) or a hop count (1). Never `true`/`*`.
TRUST_PROXY=loopback

# Max argon2 hash/verify operations at once (each ~64 MiB + a CPU core); the rest queue.
ARGON2_MAX_CONCURRENCY=4
