# Copy to .env and adjust. Never commit .env.
PORT=3000

# Matches docker-compose.yml (local development only)
POSTGRES_USER=renest
POSTGRES_PASSWORD=renest
POSTGRES_DB=renest
DATABASE_URL="postgresql://renest:renest@localhost:5432/renest?schema=public"

# Password given to every seeded account (`npm run db:seed`). Local/dev only, at least 8 chars.
SEED_USER_PASSWORD=change-me-locally

# Dedicated database for `npm run test:e2e` (created and migrated automatically). Must differ from
# DATABASE_URL so e2e runs never touch dev data.
E2E_DATABASE_URL="postgresql://renest:renest@localhost:5432/renest_e2e?schema=public"
