#!/bin/sh
# Git pre-commit hook (enabled via `core.hooksPath`, set by `npm install`).
# E2E tests need Postgres and are left to QA: run `npm run test:e2e` before committing endpoints.
set -e
cd "$(git rev-parse --show-toplevel)"

[ -d node_modules ] || { echo "pre-commit: run npm install first" >&2; exit 1; }

npm run --silent lint
npm run --silent format:check
npm run --silent typecheck
npm run --silent test
