// ReNest — MVP R1 "The Handshake" (Epics 1–5 + login)
// Postgres · auth delegated to Firebase Auth / Auth0
// Paste into https://dbdiagram.io to render the diagram.

Enum listing_condition {
  new
  like_new
  good
  fair
  // ⚠ Align with the exact "fixed set" from the prototype / Epic 4 AC
}

Enum listing_status {
  active      // published, reservable
  pending     // reserved, waiting for pickup
  completed   // both confirmations done
}

Enum reservation_status {
  reserved
  completed
}

Table users {
  id            uuid [pk]
  auth_uid      varchar(128) [not null, unique, note: 'Firebase/Auth0 UID. We never store passwords']
  email         varchar(255) [not null, unique]
  full_name     varchar(120) [not null]
  phone_e164    varchar(20)  [note: 'Nullable → fallback "can\'t be reached this way" (PM-120/129/141)']
  avatar_url    varchar(500)
  city          varchar(100)
  is_verified   boolean [not null, default: false, note: 'Set manually by the ReNest team']
  verified_at   timestamptz
  created_at    timestamptz [not null, default: `now()`]
}

Table categories {
  id    serial [pk]
  name  varchar(60) [not null, unique]
  slug  varchar(60) [not null, unique]
}

Table listings {
  id                 uuid [pk]
  seller_id          uuid [not null, ref: > users.id]
  category_id        int  [not null, ref: > categories.id]
  title              varchar(120) [not null]
  description        text [not null]
  condition          listing_condition [not null]
  price_amount       decimal(12,2) [not null, note: 'CHECK (price_amount >= 0)']
  currency           char(3) [not null, note: 'ISO 4217: COP, MXN, ARS...']
  area_label         varchar(120) [not null, note: 'Public location for cards (neighborhood/city). The exact address lives in pickup_options']
  status             listing_status [not null, default: 'active']
  creation_started_at timestamptz [note: 'Sent by the client when tapping "Create listing" → Time to First Listing KPI']
  published_at       timestamptz [not null, default: `now()`]
  created_at         timestamptz [not null, default: `now()`]
  updated_at         timestamptz [not null, default: `now()`]

  indexes {
    (status, published_at)   // feed
    (status, category_id)    // category filter
    (seller_id, status)      // My Listings per tab
  }

  Note: 'Keyword search: GIN index on to_tsvector(title || description) (added in a SQL migration)'
}

Table listing_photos {
  id          uuid [pk]
  listing_id  uuid [not null, ref: > listings.id]
  storage_key varchar(500) [not null, note: 'S3/R2 object key']
  position    smallint [not null, note: '0 = cover photo']
  created_at  timestamptz [not null, default: `now()`]

  indexes {
    (listing_id, position) [unique]
  }

  Note: 'Publish is blocked without at least 1 photo (PM-136) → validated in the service, in the same transaction'
}

// Location + time pair defined by the seller (Epic 4 / PM-134)
Table pickup_options {
  id             uuid [pk]
  listing_id     uuid [not null, ref: > listings.id]
  location_label varchar(120) [not null]
  address        varchar(255) [not null, note: 'PRIVATE: only visible to the seller and the buyer holding the reservation']
  latitude       decimal(9,6)
  longitude      decimal(9,6)
  pickup_date    date [not null]
  start_time     time [not null]
  end_time       time [not null, note: 'CHECK (end_time > start_time)']
  created_at     timestamptz [not null, default: `now()`]

  indexes {
    listing_id
    (id, listing_id) [unique, note: 'Target of the composite FK from reservations']
  }
}

// Reservation = the transaction (purchase for the buyer, sale record for the seller)
Table reservations {
  id                    uuid [pk]
  listing_id            uuid [not null, unique, ref: > listings.id, note: 'UNIQUE = concurrency: only 1 reservation per item (PM-122)']
  pickup_option_id      uuid [not null]
  buyer_id              uuid [not null, ref: > users.id]
  status                reservation_status [not null, default: 'reserved']
  reserved_at           timestamptz [not null, default: `now()`]
  buyer_received_at     timestamptz [note: '"I picked up the item"']
  seller_handed_over_at timestamptz [note: 'Confirm handover (C10)']
  completed_at          timestamptz [note: 'Set once both timestamps exist → North Star']

  indexes {
    (buyer_id, status)   // My Purchases: In progress / Completed
  }

  Note: '''
  Composite FK: (pickup_option_id, listing_id) → pickup_options(id, listing_id).
  Guarantees at the DB level that the buyer only picks a pair from THAT listing (rule #1).
  CHECK (buyer_id <> seller) is validated in the service.
  '''
}

Ref: reservations.(pickup_option_id, listing_id) > pickup_options.(id, listing_id) [delete: restrict]

// Inspection checklist on reception (Epic 3) → Dispute Rate KPI
Table reception_checklists {
  reservation_id        uuid [pk, ref: - reservations.id]
  matches_photos        boolean [not null]
  condition_as_listed   boolean [not null]
  all_parts_included    boolean [not null]
  notes                 text
  created_at            timestamptz [not null, default: `now()`]

  Note: '⚠ Tentative columns: align with the AC items. Dispute = any of them false'
}

// 1–5 rating from the buyer to the seller (A8)
Table seller_ratings {
  id             uuid [pk]
  reservation_id uuid [not null, unique, ref: - reservations.id]
  seller_id      uuid [not null, ref: > users.id]
  buyer_id       uuid [not null, ref: > users.id]
  stars          smallint [not null, note: 'CHECK (stars BETWEEN 1 AND 5)']
  created_at     timestamptz [not null, default: `now()`]

  indexes {
    seller_id   // average for the badge / seller snapshot
  }
}

// KPI instrumentation (open question in the brief: nobody owns it yet)
Table analytics_events {
  id          bigserial [pk]
  user_id     uuid [ref: > users.id]
  event_name  varchar(60) [not null, note: 'search_performed, filter_applied, item_opened, whatsapp_tapped, schedule_pickup_tapped...']
  listing_id  uuid [ref: > listings.id]
  properties  jsonb
  session_id  varchar(64)
  created_at  timestamptz [not null, default: `now()`]

  indexes {
    (event_name, created_at)
  }
}
