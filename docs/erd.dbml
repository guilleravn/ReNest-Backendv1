// ReNest — MVP R1 "The Handshake" (Epics 1–5 + login and sign-up)
// Postgres · own auth: email + password (argon2/bcrypt hash) → single JWT access token (no refresh tokens, see security.md)
// Paste into https://dbdiagram.io to render the diagram.
//
// Conventions (database.md / naming.md):
// - IDs are UUID v7 (@default(uuid(7))) unless noted. Enum values are UPPER_SNAKE (same in Prisma and in the DB).
// - Prisma does not generate CHECK constraints: every "CHECK (...)" below is added by hand in the
//   migration SQL (prisma migrate dev --create-only).
// - onDelete is Restrict unless the ref says otherwise.
// - Implemented so far (prisma/schema.prisma): users, categories, listings, listing_photos, pickup_options.
//   reservations, reception_checklists and seller_ratings are added by the slices that need them.

Enum listing_condition {
  LIKE_NEW
  GENTLY_USED
  HEAVILY_USED
}

Enum listing_status {
  ACTIVE      // published, reservable
  PENDING     // reserved, waiting for the seller's handover
  COMPLETED   // seller confirmed the handover (C10) → My Listings "Completed" tab
}

Enum reservation_status {
  RESERVED    // buyer has not confirmed reception yet → My Purchases "In progress"
  COMPLETED   // buyer confirmed reception (A7) → My Purchases "Completed"
}

Enum weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

Table users {
  id            uuid [pk]
  email         varchar(255) [not null, unique, note: 'Stored trimmed + lowercased (normalized by the auth DTOs). UNIQUE → one account per email; P2002 on sign-up → 409']
  password_hash varchar(255) [not null, note: 'argon2/bcrypt hash. Never returned by the API or logged']
  full_name     varchar(120) [not null]
  phone_e164    varchar(20)  [note: 'Nullable → WhatsApp fallback "can\'t be reached this way". Exposure rules: security.md']
  city          varchar(100) [not null, note: 'PUBLIC. Shown as the listing location on cards and detail (sellers have no per-listing area field). One of USER_ZONES (src/users/user-zones.ts), enforced by the sign-up DTO']
  is_verified   boolean [not null, default: false, note: 'Set manually by the ReNest team']
  verified_at   timestamptz
  terms_accepted_at timestamptz [note: 'Set at sign-up. NULL for the seeded accounts, which predate the terms checkbox']
  created_at    timestamptz [not null, default: `now()`]
  updated_at    timestamptz [not null, default: `now()`]
}

Table categories {
  id          uuid [pk]
  name        varchar(60) [not null, unique]
  slug        varchar(60) [not null, unique]
  created_at  timestamptz [not null, default: `now()`]
  updated_at  timestamptz [not null, default: `now()`]
}

Table listings {
  id            uuid [pk]
  seller_id     uuid [not null, ref: > users.id]
  category_id   uuid [not null, ref: > categories.id]
  title         varchar(120) [not null]
  description   text [note: 'Optional in the create form (UI marks it "Opcional"): NULL when not given']
  condition     listing_condition [not null]
  price_cents   int [not null, note: 'USD minor units (database.md); the MVP is single-currency, so there is no currency column. CHECK (price_cents >= 100): at least $1. CHECK (price_cents % 100 = 0): whole dollars']
  status        listing_status [not null, default: 'ACTIVE']
  published_at  timestamptz [not null, default: `now()`]
  created_at    timestamptz [not null, default: `now()`]
  updated_at    timestamptz [not null, default: `now()`]

  indexes {
    (status, published_at)   // feed
    (status, category_id)    // category filter
    (seller_id, status)      // My Listings per tab
  }

  Note: '''
  Search (B1, BO-5): keyword match on the title only: title ILIKE '%kw%'. Optional pg_trgm GIN index on title
  (added in a SQL migration) if the seed grows.

  Publish (one transaction, no drafts): requires at least 1 photo and at least 1 pickup option.

  Status lifecycle (always updated in the same transaction as the reservation change):
  - ACTIVE → PENDING: on reserve, via UPDATE listings SET status = 'PENDING' WHERE id = ? AND status = 'ACTIVE'.
    0 rows updated → 409 (already reserved or completed).
  - PENDING → COMPLETED: when the seller confirms the handover (reservations.seller_handed_over_at set, C10).
  The buyer side is independent: see reservations.status.
  '''
}

Table listing_photos {
  id          uuid [pk]
  listing_id  uuid [not null, ref: > listings.id, note: 'onDelete: Cascade']
  storage_key varchar(500) [not null, note: 'S3/R2 object key']
  position    smallint [not null, note: '0 = cover photo']
  created_at  timestamptz [not null, default: `now()`]
  updated_at  timestamptz [not null, default: `now()`]

  indexes {
    (listing_id, position) [unique]
  }

  Note: 'Publish is blocked without at least 1 photo → validated in the service, in the same transaction'
}

// Pickup pair defined by the seller (A2, BO-23): one location + one or more weekdays + one hour range.
// Example: "Parque Lleras, MONDAY+WEDNESDAY, 10:00–13:00" and "Office lobby, SATURDAY, 16:00–20:00" are two pairs.
// The buyer reserves a pair as a whole; the exact day among its weekdays is coordinated on WhatsApp.
Table pickup_options {
  id             uuid [pk]
  listing_id     uuid [not null, ref: > listings.id, note: 'onDelete: Cascade (a reserved option is protected by the Restrict FK from reservations)']
  location_label varchar(120) [not null, note: 'PUBLIC: shown to any buyer choosing an option. CHECK (btrim(location_label) <> \'\')']
  address        varchar(255) [not null, note: 'PRIVATE: only visible to the seller and the buyer holding the reservation. CHECK (btrim(address) <> \'\')']
  latitude       decimal(9,6) [note: 'PRIVATE (same as address): coordinates reveal the exact location']
  longitude      decimal(9,6) [note: 'PRIVATE (same as address)']
  weekdays       "weekday[]" [not null, note: 'PUBLIC. Prisma: Weekday[]. CHECK (cardinality(weekdays) >= 1). No duplicates (validated in the DTO)']
  start_time     time [not null, note: 'PUBLIC. Local wall-clock time of the meetup city (no timezone needed). Prisma: DateTime @db.Time']
  end_time       time [not null, note: 'PUBLIC. CHECK (end_time > start_time)']
  created_at     timestamptz [not null, default: `now()`]
  updated_at     timestamptz [not null, default: `now()`]

  indexes {
    listing_id
    (id, listing_id) [unique, note: 'Target of the composite FK from reservations']
  }

  Note: '''
  A published listing always has at least 1 pickup option: required at publish (C5), and the last one
  cannot be removed (C7). Options can only be added/edited/removed while the listing is ACTIVE and unreserved.
  '''
}

// Reservation = the transaction (purchase for the buyer, sale record for the seller)
Table reservations {
  id                    uuid [pk]
  listing_id            uuid [not null, unique, ref: > listings.id, note: 'UNIQUE = concurrency: only 1 reservation per item. Also means no cancellation in the MVP']
  pickup_option_id      uuid [not null]
  buyer_id              uuid [not null, ref: > users.id]
  status                reservation_status [not null, default: 'RESERVED', note: 'Buyer side. CHECK ((status = \'COMPLETED\') = (buyer_received_at IS NOT NULL))']
  reserved_at           timestamptz [not null, default: `now()`]
  seller_handed_over_at timestamptz [note: 'Seller confirms handover (C10). Moves the listing to COMPLETED in the same transaction']
  buyer_received_at     timestamptz [note: '"I picked up the item" (A7). Sets status = COMPLETED. Independent of the seller step']
  created_at            timestamptz [not null, default: `now()`]
  updated_at            timestamptz [not null, default: `now()`]

  indexes {
    (buyer_id, status)   // My Purchases: In progress / Completed
  }

  Note: '''
  Composite FK: (pickup_option_id, listing_id) → pickup_options(id, listing_id).
  Guarantees at the DB level that the buyer only picks a pair from THAT listing.
  No self-reservation: buyer_id <> listings.seller_id, validated in the service (cross-table, no CHECK).
  Reservation insert + listing status update run in one transaction (see listings note).

  Two independent confirmations:
  - Seller handover → seller_handed_over_at + listings.status = COMPLETED (My Listings).
  - Buyer reception → buyer_received_at + status = COMPLETED (My Purchases). This is the confirmation that
    matters for the buyer: it unlocks the inspection checklist and the rating, whether or not the seller confirmed first.
  North Star (Completed Transactions/week): both timestamps set, counted at GREATEST(seller_handed_over_at, buyer_received_at).
  '''
}

Ref: reservations.(pickup_option_id, listing_id) > pickup_options.(id, listing_id) [delete: restrict]

// Inspection checklist on reception (A7, BO-20)
Table reception_checklists {
  reservation_id        uuid [pk, ref: - reservations.id]
  matches_listing       boolean [not null, note: 'Item matches the listing']
  no_undisclosed_damage boolean [not null]
  all_parts_included    boolean [not null]
  powers_on             boolean [note: 'NULL = not applicable (non-electronic item)']
  created_at            timestamptz [not null, default: `now()`]
  updated_at            timestamptz [not null, default: `now()`]

  Note: 'Saved together with buyer_received_at, by the buyer of that reservation'
}

// 1–5 rating from the buyer to the seller (A8)
Table seller_ratings {
  id             uuid [pk]
  reservation_id uuid [not null, unique, ref: - reservations.id]
  seller_id      uuid [not null, ref: > users.id, note: 'Denormalized for the average index. Always copied from reservation → listing.seller_id, never from client input']
  stars          smallint [not null, note: 'CHECK (stars BETWEEN 1 AND 5)']
  created_at     timestamptz [not null, default: `now()`]
  updated_at     timestamptz [not null, default: `now()`]

  indexes {
    seller_id   // average for the badge / seller snapshot
  }

  Note: '''
  The rater is reservations.buyer_id (no buyer_id column here).
  Service rule: only the buyer of that reservation can rate, and only once buyer_received_at is set.
  '''
}
